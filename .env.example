# Example configuration only. Do not place real secrets in source control.
OPENCLAW_ENV=development
OPENCLAW_PORT=8080

# Model provider selection
MODEL_PROVIDER=bedrock
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=replace-with-approved-model-id

# Optional external provider example
MODEL_API_KEY=replace-me

# Memory / state
MEMORY_BACKEND=postgres
POSTGRES_HOST=memory
POSTGRES_PORT=5432
POSTGRES_DB=openclaw
POSTGRES_USER=openclaw
POSTGRES_PASSWORD=replace-me

# Security controls
ENABLE_TOOL_EXECUTION=false
TOOL_ALLOWLIST=knowledge_search,status_lookup
LOG_LEVEL=INFO
