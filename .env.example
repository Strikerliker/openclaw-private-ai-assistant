# Example configuration only. Copy to .env and replace local demo values.
# Never commit real tokens, cloud credentials, or production configuration.

OPENCLAW_HOST=0.0.0.0
OPENCLAW_PORT=8080
LOCAL_API_TOKEN=replace-with-a-long-random-local-token

# deterministic = offline portfolio demo; bedrock = Amazon Bedrock inference
PROVIDER_MODE=deterministic
MODEL_ID=amazon.nova-lite-v1:0
AWS_REGION=us-east-1

# sqlite = local persistent memory; dynamodb = AWS deployment; memory = ephemeral
MEMORY_BACKEND=sqlite
SQLITE_PATH=/data/openclaw.db
MEMORY_TABLE=

LOG_LEVEL=INFO
